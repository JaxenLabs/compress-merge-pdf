    "images": "node scripts/make-images.mjs",
    "predev": "node scripts/copy-pdfjs.mjs",
    "prebuild": "node scripts/copy-pdfjs.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
