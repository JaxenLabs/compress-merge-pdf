{
  "name": "compress-merge-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "Compress PDF by JaxScan: compress and merge PDF files 100% in the browser. Static export for GitHub Pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
